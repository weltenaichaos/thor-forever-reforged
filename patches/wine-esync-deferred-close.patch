+/* A cache slot is claimed with this type while its fd and shm are filled in.
+ * On ARM64, another thread may otherwise see the new type together with the
+ * fd and shm of the object that used the slot before. */
+#define ESYNC_TYPE_PENDING  ((LONG)-1)
+
+static LONG load_slot_type( struct esync *obj )
+{
+    LONG type;
+
+    while ((type = __atomic_load_n( (LONG *)&obj->type, __ATOMIC_ACQUIRE )) == ESYNC_TYPE_PENDING)
+        sched_yield();
+    return type;
+}
