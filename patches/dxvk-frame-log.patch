   }
 
diff --git a/src/d3d11/d3d11_frame_stats.h b/src/d3d11/d3d11_frame_stats.h
new file mode 100644
index 0000000..fb708be
--- /dev/null
+++ b/src/d3d11/d3d11_frame_stats.h
@@ -0,0 +1,53 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+#include "../util/util_time.h"
+
+namespace dxvk {
+
+  /**
+   * \brief Time spent creating shaders and resources, for DXVK_FRAME_LOG
+   *
+   * Only measured while the frame log is on, so normal play pays nothing
+   * beyond one relaxed load per call.
+   */
+  struct D3D11FrameStats {
+    static inline std::atomic<bool>     enabled       = { false };
+    static inline std::atomic<uint64_t> shaderUs      = { 0u };
+    static inline std::atomic<uint64_t> shaderCount   = { 0u };
+    static inline std::atomic<uint64_t> resourceUs    = { 0u };
+    static inline std::atomic<uint64_t> resourceCount = { 0u };
+  };
+
+  class D3D11FrameStatsScope {
+
+  public:
+
+    D3D11FrameStatsScope(std::atomic<uint64_t>& us, std::atomic<uint64_t>& count)
+    : m_us(us), m_count(count), m_on(D3D11FrameStats::enabled.load(std::memory_order_relaxed)) {
+      if (m_on)
+        m_start = dxvk::high_resolution_clock::now();
+    }
+
+    ~D3D11FrameStatsScope() {
+      if (!m_on)
+        return;
+
+      auto us = std::chrono::duration_cast<std::chrono::microseconds>(
+        dxvk::high_resolution_clock::now() - m_start).count();
+      m_us.fetch_add(uint64_t(us), std::memory_order_relaxed);
+      m_count.fetch_add(1u, std::memory_order_relaxed);
+    }
+
+  private:
+
+    std::atomic<uint64_t>& m_us;
+    std::atomic<uint64_t>& m_count;
+    bool m_on;
+    dxvk::high_resolution_clock::time_point m_start;
+
+  };
+
+}
