       m_featuresSupported.extExtendedDynamicState3.extendedDynamicState3DepthClipEnable = VK_FALSE;
+
+    // The presenter's *2 surface queries need the matching instance
+    // extensions. Some Wine/Android instances expose the device-level
+    // extensions without them, as DXVK 2.4 already checked.
+    if (!instance.extensions().khrGetSurfaceCapabilities2.specVersion)
+      m_featuresSupported.extFullScreenExclusive = VK_FALSE;
+
+    if (!instance.extensions().extSurfaceMaintenance1.specVersion
+     || !instance.extensions().khrGetSurfaceCapabilities2.specVersion)
+      m_featuresSupported.extSwapchainMaintenance1.swapchainMaintenance1 = VK_FALSE;
   }
 
 
