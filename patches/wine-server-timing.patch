+/* With WINESERVER_STATS=1 (the app's "Debug: time Wine server calls"), measure where the
+ * server's time goes and print a summary to stderr every 5 seconds: its CPU time, how long
+ * it waited for work, and which request types took longest to handle. */
+int server_stats;
+static struct
+{
+    unsigned int count;
+    unsigned long long ns;
+} server_stats_req[REQ_NB_REQUESTS];
+static unsigned long long server_stats_start, server_stats_wait_ns, server_stats_read_ns, server_stats_reply_ns;
+static unsigned long long server_stats_user_ns, server_stats_sys_ns;
+static unsigned int server_stats_wakeups, server_stats_events;
+
+unsigned long long server_stats_now(void)
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+
+/* called by the main loop after each wait for work */
+void server_stats_waited( unsigned long long start, int events )
+{
+    unsigned long long now = server_stats_now(), user, sys, handled_ns = 0;
+    unsigned int i, j, top, requests = 0;
+    struct rusage ru;
+
+    server_stats_wait_ns += now - start;
+    server_stats_wakeups++;
+    if (events > 0) server_stats_events += events;
+    if (server_stats_start && now - server_stats_start < 5000000000ull) return;
+
+    getrusage( RUSAGE_SELF, &ru );
+    user = ru.ru_utime.tv_sec * 1000000000ull + ru.ru_utime.tv_usec * 1000ull;
+    sys = ru.ru_stime.tv_sec * 1000000000ull + ru.ru_stime.tv_usec * 1000ull;
+    if (server_stats_start)
+    {
+        for (i = 0; i < REQ_NB_REQUESTS; i++)
+        {
+            requests += server_stats_req[i].count;
+            handled_ns += server_stats_req[i].ns;
+        }
+        fprintf( stderr, "wineserver-stats: %.1f s: cpu user %.0f ms sys %.0f ms, waiting %.0f ms, %u wakeups %u events, "
+                 "%u requests: handling %.0f ms, reading %.0f ms, replying %.0f ms; slowest:",
+                 (now - server_stats_start) / 1e9, (user - server_stats_user_ns) / 1e6, (sys - server_stats_sys_ns) / 1e6,
+                 server_stats_wait_ns / 1e6, server_stats_wakeups, server_stats_events, requests, handled_ns / 1e6,
+                 server_stats_read_ns / 1e6, server_stats_reply_ns / 1e6 );
+        for (j = 0; j < 10; j++)
+        {
+            top = REQ_NB_REQUESTS;
+            for (i = 0; i < REQ_NB_REQUESTS; i++)
+                if (server_stats_req[i].count && (top == REQ_NB_REQUESTS || server_stats_req[i].ns > server_stats_req[top].ns))
+                    top = i;
+            if (top == REQ_NB_REQUESTS) break;
+            fprintf( stderr, " %s %u/%.1fms", get_req_name( top ), server_stats_req[top].count, server_stats_req[top].ns / 1e6 );
+            server_stats_req[top].count = 0;  /* printed */
+        }
+        fprintf( stderr, "\n" );
+        select_stats_report();
+    }
+    memset( server_stats_req, 0, sizeof(server_stats_req) );
+    server_stats_wait_ns = server_stats_read_ns = server_stats_reply_ns = 0;
+    server_stats_wakeups = server_stats_events = 0;
+    server_stats_user_ns = user;
+    server_stats_sys_ns = sys;
+    server_stats_start = now;
+}
