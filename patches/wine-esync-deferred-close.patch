+/* Some other code in the process (seen with GPU drivers that close fence
+ * fds twice) can close an fd number it no longer owns. New fds get the
+ * lowest free number, so such a stray close() easily hits a recent esync
+ * fd: its writes then fail with EBADF and the signal is lost, or the number
+ * is reused and the wrong object is signaled. Keep esync fds in a high range
+ * that normal allocations never reach. */
+#define ESYNC_FD_BASE 16384
+
+static int esync_move_fd_high( int fd )
+{
+    int high;
+
+    if (fd < 0 || fd >= ESYNC_FD_BASE) return fd;
+    if ((high = fcntl( fd, F_DUPFD_CLOEXEC, ESYNC_FD_BASE )) < 0) return fd;
+    close( fd );
+    return high;
+}
+
+/* The server answered but no fd arrived with its message. The kernel drops
+ * a passed fd when the process cannot take another one, so log how many
+ * fds are open and of which kind, to see what fills the table. */
+static void log_missing_fd( HANDLE handle, int type )
+{
+    static LONG logged;
+    unsigned int total = 0, eventfds = 0, syncfiles = 0, anon = 0, sockets = 0, devices = 0, files = 0;
+    int highest = -1;
+    struct rlimit rl = { 0 };
+    char path[64], target[256];
+    struct dirent *de;
+    DIR *dir;
+
+    if (InterlockedIncrement( &logged ) > 20) return;
+    getrlimit( RLIMIT_NOFILE, &rl );
+    if ((dir = opendir( "/proc/self/fd" )))
+    {
+        while ((de = readdir( dir )))
+        {
+            ssize_t len;
+            int n;
+
+            if (de->d_name[0] < '0' || de->d_name[0] > '9') continue;
+            n = atoi( de->d_name );
+            total++;
+            if (n > highest) highest = n;
+            snprintf( path, sizeof(path), "/proc/self/fd/%d", n );
+            if ((len = readlink( path, target, sizeof(target) - 1 )) <= 0) continue;
+            target[len] = 0;
+            if (strstr( target, "eventfd" )) eventfds++;
+            else if (strstr( target, "sync_file" )) syncfiles++;
+            else if (!strncmp( target, "anon_inode:", 11 )) anon++;
+            else if (!strncmp( target, "socket:", 7 )) sockets++;
+            else if (!strncmp( target, "/dev/", 5 )) devices++;
+            else files++;
+        }
+        closedir( dir );
+    }
+    ERR( "no fd received for handle %p (type %d): %u fds open (limit %llu, highest %d): "
+         "%u eventfd, %u sync_file, %u other anon, %u socket, %u device, %u file/pipe\n",
+         handle, type, total, (unsigned long long)rl.rlim_cur, highest,
+         eventfds, syncfiles, anon, sockets, devices, files );
+}
