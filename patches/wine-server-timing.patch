 /* select on a handle list */
+/* WINESERVER_STATS: which threads call select most often, and what they wait on */
+struct select_stat
+{
+    thread_id_t  tid;
+    process_id_t pid;
+    int          unix_tid;
+    unsigned int op, handles, flags, status;
+    int          timeout;  /* 0 none (poll), 1 infinite, 2 deadline */
+    char         type[16];
+    unsigned int calls;
+};
+static struct select_stat select_stats[48];
+static unsigned int select_stats_other;
+
+static void select_stats_add( const union select_op *op, data_size_t op_size, unsigned int flags, timeout_t timeout )
+{
+    struct select_stat key;
+    obj_handle_t handle = 0;
+    struct object *obj;
+    unsigned int i;
+
+    memset( &key, 0, sizeof(key) );
+    key.tid = current->id;
+    key.pid = current->process->id;
+    key.unix_tid = current->unix_tid;
+    key.op = op_size >= sizeof(op->op) ? op->op : SELECT_NONE;
+    key.flags = flags;
+    key.status = get_error();
+    key.timeout = !timeout ? 0 : timeout == TIMEOUT_INFINITE ? 1 : 2;
+    switch (key.op)
+    {
+    case SELECT_WAIT:
+    case SELECT_WAIT_ALL:
+        key.handles = (op_size - offsetof( union select_op, wait.handles )) / sizeof(obj_handle_t);
+        if (key.handles) handle = op->wait.handles[0];
+        break;
+    case SELECT_SIGNAL_AND_WAIT:
+        handle = op->signal_and_wait.wait;
+        break;
+    case SELECT_KEYED_EVENT_WAIT:
+    case SELECT_KEYED_EVENT_RELEASE:
+        handle = op->keyed_event.handle;
+        break;
+    }
+    if (handle && (obj = get_handle_obj( current->process, handle, 0, NULL )))
+    {
+        const struct unicode_str *name = &obj->ops->type->name;
+        for (i = 0; i < name->len / sizeof(WCHAR) && i < sizeof(key.type) - 1; i++)
+            key.type[i] = name->str[i] < 0x80 ? name->str[i] : '?';
+        release_object( obj );
+    }
+    clear_error();
+    set_error( key.status );
+
+    for (i = 0; i < ARRAY_SIZE(select_stats) && select_stats[i].calls; i++)
+    {
+        struct select_stat *s = &select_stats[i];
+        if (s->tid == key.tid && s->op == key.op && s->handles == key.handles && s->flags == key.flags &&
+            s->status == key.status && s->timeout == key.timeout && !strcmp( s->type, key.type ))
+        {
+            s->calls++;
+            return;
+        }
+    }
+    if (i == ARRAY_SIZE(select_stats))
+    {
+        select_stats_other++;
+        return;
+    }
+    key.calls = 1;
+    select_stats[i] = key;
+}
+
+/* print the most frequent select calls since the last report */
+void select_stats_report(void)
+{
+    static const char * const ops[] = { "none", "wait", "wait_all", "signal_and_wait", "keyed_wait", "keyed_release" };
+    static const char * const timeouts[] = { "poll", "infinite", "deadline" };
+    unsigned int i, j, top;
+
+    fprintf( stderr, "wineserver-selects:" );
+    for (j = 0; j < 8; j++)
+    {
+        top = ARRAY_SIZE(select_stats);
+        for (i = 0; i < ARRAY_SIZE(select_stats) && select_stats[i].calls; i++)
+            if (select_stats[i].calls != ~0u && (top == ARRAY_SIZE(select_stats) || select_stats[i].calls > select_stats[top].calls))
+                top = i;
+        if (top == ARRAY_SIZE(select_stats)) break;
+        fprintf( stderr, " [%u x thread %04x of process %04x (linux %d) %s %u handles %s flags %x %s -> %08x]",
+                 select_stats[top].calls, select_stats[top].tid, select_stats[top].pid, select_stats[top].unix_tid,
+                 select_stats[top].op < ARRAY_SIZE(ops) ? ops[select_stats[top].op] : "?", select_stats[top].handles,
+                 select_stats[top].type[0] ? select_stats[top].type : "-", select_stats[top].flags,
+                 timeouts[select_stats[top].timeout], select_stats[top].status );
+        select_stats[top].calls = ~0u;  /* printed */
+    }
+    if (select_stats_other) fprintf( stderr, " [%u other]", select_stats_other );
+    fprintf( stderr, "\n" );
+    memset( select_stats, 0, sizeof(select_stats) );
+    select_stats_other = 0;
+}
